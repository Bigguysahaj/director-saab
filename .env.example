# Server-side OpenRouter API key.
OPENROUTER_API_KEY=
# Local storage: public https base URL for this app (e.g. an ngrok tunnel).
PUBLIC_MEDIA_BASE_URL=
# R2 storage: set all five R2 variables to use R2 instead of local disk.
R2_ACCOUNT_ID=
# R2 API token access key ID.
R2_ACCESS_KEY_ID=
# R2 API token secret access key.
R2_SECRET_ACCESS_KEY=
# R2 bucket for public reference media.
R2_BUCKET=
# Public https bucket URL (r2.dev or custom domain).
R2_PUBLIC_BASE_URL=
